<h1>The Library</h1>
<br>
I’ve always been a big reader and can average about a book a week (more when we throw comics in the mix.) But as I get older, it’s hard for things to not start to blur together, so I started keeping a list.

Rather than use reading trackers that have distracting social media components, I opted to keep it here on my blog. In each book you’ll find a synopsis and some notes on what I thought of it. Don’t think of these as book reviews — they are far more stream of conscious and sometimes contain mild spoilers.
<br><br>
This collection has been built using Nate Finch’s handy My Reads plugin for WordPress, with a modifying plugin I put together to add additional Readers’ Advisory tag classifications. Here’s what those mean:<br><br>

<h2>Subjects</h2>
<br>
Exactly what it sounds like. Being a librarian, I like to use general subject headings such as “Religion,” “Self-Improvement” etc. In fiction titles, subject headings can also include general terms that feature in the book. For example, if a main character’s background mentions that they are former military, that means the subject heading “Veterans” would be appropriate.<br><br>

<h2>Appeal Factors</h2>
<br>
Think of these as a more descriptive form of subject headings that are intended to describe the book in a more stylistic fashion. Appeal factors are all about the vibes and are what really connects a reader to what they want to read.
<br>
<br>
<hr>

{% set postslist = collections.books %}

<div class="books-filters">
	<label>
		<span>Genre</span>
		<select id="genre-filter">
			<option value="all">All genres</option>
		</select>
	</label>
	<label>
		<span>Finished year</span>
		<select id="year-filter">
			<option value="all">All years</option>
		</select>
	</label>
</div>

<div class="books-grid" id="books-grid">
	{%- for post in postslist | reverse %}
		{% set shelfValue = post.data.shelf | default('') | lower %}
		{% set shelfClass = '' %}
		{% if shelfValue == 'finished' or shelfValue == 'complete' or shelfValue == 'completed' %}
			{% set shelfClass = 'shelf-badge--finished' %}
		{% elseif shelfValue == 'reading' or shelfValue == 'currently-reading' or shelfValue == 'currently reading' %}
			{% set shelfClass = 'shelf-badge--reading' %}
		{% elseif shelfValue == 'tbr' or shelfValue == 'to-be-read' or shelfValue == 'to be read' %}
			{% set shelfClass = 'shelf-badge--tbr' %}
		{% elseif shelfValue == 'dnf' or shelfValue == 'did-not-finish' or shelfValue == 'did not finish' %}
			{% set shelfClass = 'shelf-badge--dnf' %}
		{% endif %}
		{% set coverImageSource = post.data.coverImage | default('') %}
		{% set coverImagePath = '' %}
		{% if coverImageSource %}
			{% if coverImageSource[0] == '/' %}
				{% set coverImagePath = coverImageSource %}
			{% elif coverImageSource[0] == '.' %}
				{% set coverImagePath = post.url ~ coverImageSource | replace('./', '') %}
			{% else %}
				{% set coverImagePath = post.url ~ 'images/' ~ coverImageSource %}
			{% endif %}
		{% endif %}
		<article class="book-card" data-genre="{{ post.data.genre | default('uncategorized') | lower }}" data-year="{{ post.data.completed | default('') }}">
			<a href="{{ post.url }}" class="book-card-link" aria-label="Open {{ post.data.title }}">
				{% if coverImagePath %}
				<div class="book-card-image">
					<img src="{{ coverImagePath }}" alt="{{ post.data.title }} cover">
					{% if post.data.shelf %}
					<span class="shelf-badge {{ shelfClass }}">{{ post.data.shelf }}</span>
					{% endif %}
				</div>
				{% endif %}
			</a>
		</article>
	{%- endfor %}
</div>

<script>
	(function () {
		const cards = Array.from(document.querySelectorAll('.book-card'));
		const genreFilter = document.getElementById('genre-filter');
		const yearFilter = document.getElementById('year-filter');

		if (!genreFilter || !yearFilter || !cards.length) return;

		const genres = new Set();
		const years = new Set();
		cards.forEach((card) => {
			const genre = card.dataset.genre || 'uncategorized';
			const year = card.dataset.year || 'unknown';
			genres.add(genre);
			years.add(year);
		});

		[...genres].sort().forEach((genre) => {
			const option = document.createElement('option');
			option.value = genre;
			option.textContent = genre.charAt(0).toUpperCase() + genre.slice(1);
			genreFilter.appendChild(option);
		});

		[...years].filter(Boolean).sort((a, b) => Number(b) - Number(a)).forEach((year) => {
			const option = document.createElement('option');
			option.value = year;
			option.textContent = year;
			yearFilter.appendChild(option);
		});

		const applyFilters = () => {
			const selectedGenre = genreFilter.value;
			const selectedYear = yearFilter.value;

			cards.forEach((card) => {
				const matchesGenre = selectedGenre === 'all' || card.dataset.genre === selectedGenre;
				const matchesYear = selectedYear === 'all' || card.dataset.year === selectedYear;
				card.style.display = matchesGenre && matchesYear ? '' : 'none';
			});
		};

		genreFilter.addEventListener('change', applyFilters);
		yearFilter.addEventListener('change', applyFilters);
	})();
</script>
</div>