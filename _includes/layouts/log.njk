---
layout: layouts/base2.njk
---
<style>{% include "css/index.css" %}</style>


{# Only include the syntax highlighter CSS on blog posts, included with the CSS per-page bundle #}
<style>{% include "node_modules/prismjs/themes/prism-okaidia.css" %}</style>
<style>{% include "css/prism-diff.css" %}</style>
<style>{% include "css/log.css" %}</style>

<div class="log-header">
	<div class="log-meta">
		<div class="log-meta-column">
			{% if coverImage %}
			<div class="log-image">
				<img src="{{ coverImage }}" alt="{{ title }} cover image">
			</div>
			{% endif %}
		</div>

		<div class="log-details-column">
		<div class="log-title-row">
			<h1>{{ title }}</h1>
			{% if shelf %}
			{% set shelfValue = shelf | lower %}
			<div class="shelf-badge{% if shelfValue == 'finished' or shelfValue == 'complete' or shelfValue == 'completed' %} shelf-badge--finished{% elseif shelfValue == 'reading' or shelfValue == 'currently-reading' or shelfValue == 'currently reading' %} shelf-badge--reading{% elseif shelfValue == 'tbr' or shelfValue == 'to-be-read' or shelfValue == 'to be read' %} shelf-badge--tbr{% elseif shelfValue == 'dnf' or shelfValue == 'did-not-finish' or shelfValue == 'did not finish' %} shelf-badge--dnf{% endif %}">{{ shelf }}</div>
			{% endif %}
		</div>
		<ul class="log-metadata" style="list-style-type: none; padding: 0; margin: 0;">
			{% if author %}
			<li><strong>Author:</strong> {{ author }}</li>
			{% endif %}

			{% if series %}
			<li><strong>Series:</strong> {{ series }}</li>
			{% endif %}

			{% if format %}
			<li><strong>Format:</strong> {{ format }}</li>
			{% endif %}

			{% if classification %}
			<li><strong>Classification:</strong> {{ classification }}</li>
			{% endif %}

			{% if genre %}
			<li><strong>Genre:</strong> {{ genre }}</li>
			{% endif %}

			{% if publisher %}
			<li><strong>Publisher:</strong> {{ publisher }}</li>
			{% endif %}

			{% if externalUrl %}
			<li><strong>URL:</strong> <a href="{{ externalUrl }}" target="_blank" rel="noopener noreferrer" class="external-link"><span>{{ externalUrl }}</span><span class="external-link-icon" aria-hidden="true">↗</span></a></li>
			{% endif %}

			{% if subject %}
			<li>
				<span class="subject-label"><strong>Subjects:</strong></span>
				{% set subjectValues = subject.split(',') %}
				{% for subjectValue in subjectValues %}
				<span class="subject-item">{{ subjectValue | trim }}</span>
				{% endfor %}
			</li>
			{% endif %}

			{% if subjects %}
			<li>
				<span class="subject-label"><strong>Subjects:</strong></span>
				{% set subjectValues = subjects.split(',') %}
				{% for subjectValue in subjectValues %}
				<span class="subject-item">{{ subjectValue | trim }}</span>
				{% endfor %}
			</li>
			{% endif %}

			{% if vibes %}
			<li>
				<span class="subject-label"><strong>Vibes:</strong></span>
				{% set vibeValues = vibes.split(',') %}
				{% for vibeValue in vibeValues %}
				<span class="vibe-item">{{ vibeValue | trim }}</span>
				{% endfor %}
			</li>
			{% endif %}

			{% if completed %}
			<li><strong>Completed in:</strong> {{ completed }}</li>
			{% endif %}

			{% if rating %}
			<li><strong>Rating:</strong> {{ rating }}</li>
			{% endif %}

			{% if studio %}
			<li><strong>Studio:</strong> {{ studio }}</li>
			{% endif %}

			{% if platform %}
			<li><strong>Platform:</strong> {{ platform }}</li>
			{% endif %}

			{% if performers %}
			<li><strong>Performers:</strong> {{ performers }}</li>
			{% endif %}

			{% if director %}
			<li><strong>Director:</strong> {{ director }}</li>
			{% endif %}

			{% if medium %}
			<li><strong>Medium:</strong> {{ medium }}</li>
			{% endif %}

			{% if artist %}
			<li><strong>Artist:</strong> {{ artist }}</li>
			{% endif %}

		</ul>

		{% if description %}
		<p class="post-description">{{ description }}</p>
		{% endif %}

		{% if summary %}
		<div class="summary">
			<p><strong>Summary:</strong> {{ summary }}</p>
		</div>
		{% endif %}
		</div>
	</div>
</div>
<div class="post-content">
	{{ content | safe }}
</div>

{%- if collections.books %}
{%- set previousPost = collections.books | getPreviousCollectionItem %}
{%- set nextPost = collections.books | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<ul class="links-nextprev">
	{%- if previousPost %}<li class="links-nextprev-prev">← Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
	{%- if nextPost %}<li class="links-nextprev-next">Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
</ul>
{%- endif %}
{%- endif %}
