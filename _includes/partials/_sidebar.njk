<style>
.container {
	display: flex;
	flex-wrap: wrap;
	flex: 1 1 auto;
	width: 100%;
	align-items: stretch;
	min-height: 100vh;
}

.sidebar {
	display: flex;
	flex-direction: column;
	flex: 1 1 100%;
	gap: 1.5rem;
	top: 0;
	padding: 2rem 1rem;
	position: relative;
	color: var(--text);
}

.sidebar a,
.sidebar a:visited {
	color: var(--sidebar);
}

.footer {
	margin-top: 6em;
	padding-top: 1rem;
	font-family: special elite;
	line-height: 1.5;
	color: var(--sidebar-text);
}

/* Header */
.sidebar .header {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	flex-wrap: wrap;
	justify-content: center;
	align-items: center;
	padding: clamp(0.5rem, 2vw, 1rem);
	text-align: center;
}

.title {
	color: var(--sidebar-text);
	font-size: clamp(1.15rem, 2.2vw, 2rem);
	line-height: 1.2;
	padding: 0;
	word-break: break-word;
	max-width: 100%;
}

.logo {
	display: flex;
	align-items: center;
	justify-content: center;
	width: clamp(5rem, 15vw, 8rem);
	height: clamp(5rem, 15vw, 8rem);
	margin: 0 auto 0.5rem;
	border-radius: 50%;
	background: rgba(255, 255, 255, 0.12);
	color: #e0def4;
	font-size: clamp(1rem, 2vw, 1.35rem);
	font-weight: 700;
	letter-spacing: 0.04em;
	overflow: hidden;
}

.logo img {
	display: block;
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.nav a[href],
.nav .nav-parent {
	font-family: "Lacquer", system-ui;
	color: var(--text);
}

.nav {
	padding-top: 20px;
	display: flex;
	flex-direction: column;
	padding: 0;
	list-style: none;
	margin: 0 0 1rem;
}

.nav > *:nth-child(6n+1) { --nav-color: #eb6f92; }
.nav > *:nth-child(6n+2) { --nav-color: #f6c177; }
.nav > *:nth-child(6n+3) { --nav-color: #ea9a97; }
.nav > *:nth-child(6n+4) { --nav-color: #3e8fb0; }
.nav > *:nth-child(6n+5) { --nav-color: #9ccfd8; }
.nav > *:nth-child(6n+6) { --nav-color: #c4a7e7; }

.nav-item {
	margin-bottom: 0.5em;
}

.nav-item a {
	display: block;
	padding: 4px;
	border-radius: 8px;
	background: var(--nav-color);
	color: var(--nav-text);
	transition: opacity 0.15s ease;
}

.nav-item a[href]:not(:hover) {
	text-decoration: none;
}

.nav-item a:hover {
	opacity: 0.82;
}

.nav-item-active > a {
	font-weight: 700;
	text-decoration: none;
}

.nav-submenu-item.nav-item-active > a {
	font-weight: 700;
	text-decoration: none;
}

/* Inherits the exact background color from the parent loop */
.nav-accordion {
	margin: 0;
	padding: 4px;
	border-radius: 8px;
	background: var(--nav-color);
	color: var(--nav-text);
	transition: opacity 0.15s ease;
	margin-bottom: 0.5em;
}

.nav-accordion:hover {
	opacity: 0.82;
}

.nav-accordion > summary {
	list-style: none;
	cursor: pointer;
	padding: 0px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
}

.nav-accordion-summary {
	display: flex;
	align-items: center;
	width: 100%;
	user-select: none;
}

.nav-accordion > summary::-webkit-details-marker {
	display: none;
}

.nav-accordion > summary::after {
	content: "\203a";
	margin-right: 4px;
	font-size: 1.5em;
	line-height: 1;
	transform: rotate(0deg);
	transition: transform 0.2s ease;
}

.nav-accordion[open] > summary::after {
	transform: rotate(90deg);
}

.nav-accordion-summary a,
.nav-accordion-summary span {
	display: inline-block;
	flex-grow: 1;
	color: var(--nav-text);
	pointer-events:none;
}

.nav-accordion-summary a[href]:not(:hover) {
	text-decoration: none;
}

.nav-submenu {
	list-style: none;
	padding: 0.25em 0 0;
	margin: 0;
}

.nav-submenu-item {
	margin-bottom: 0.2em;
}

.nav-submenu-item:last-child {
	margin-bottom: 0;
}

/* Submenu links automatically share the parent color context */
.nav-submenu-item a {
	display: block;
	padding: 4px;
	color: var(--nav-text);
}

.nav-submenu-item a[href]:not(:hover) {
	text-decoration: none;
}

.nav-submenu-item a:hover {
	text-decoration: none;
	color: var(--nav-text);
	opacity: 0.8;
}

@media (min-width: 724px) {
	.sidebar {
		flex: 0 0 30%;
		position: sticky;
		padding: 2rem 1rem 2rem 1rem;
		min-height: 100vh;
	}

	.main {
		flex: 1 1 70%;
		min-height: 100%;
	}
}

@media (max-width: 723px) {
	.footer {
		display: none;
	}
}
</style>

<div class="sidebar">
	<div class="header">
		<div class="logo" aria-hidden="true">
			<img src="/img/logo.png" alt="" eleventy:ignore>
		</div>
		<div class="title">Thoughts & Scribbles</div>
	</div>

	{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
	<nav>
		<h2 class="visually-hidden">Top level navigation menu</h2>
		<ul class="nav">
		{%- for entry in collections.all | eleventyNavigation %}
			{%- if entry.children.length %}
			<details class="nav-accordion"{% if entry.url == page.url or (page.url and entry.url and page.url.startsWith(entry.url)) %} open{% endif %}>
				<summary class="nav-accordion-summary">{{ entry.title }}</summary>
				<ul class="nav-submenu">
				{%- for child in entry.children %}
					<li class="nav-submenu-item{% if child.url == page.url %} nav-item-active{% endif %}"><a href="{{ child.url }}"{% if child.url == page.url %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
				{%- endfor %}
				</ul>
			</details>
			{%- else %}
			<li class="nav-item{% if entry.url == page.url %} nav-item-active{% endif %}"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
			{%- endif %}
		{%- endfor %}
		</ul>
	</nav>
	{% include "partials/_calendar.njk" %}
	<div class="footer">
		<p>
			<em> Hand-coded somewhere in the vastness with stubborn tenacity &amp; built with <a href="https://www.11ty.dev/">{{ eleventy.generator }}</a>. </em>
		</p>
		<p class="site-copyright">
			© <span id="current-year"></span> Brandon Johnston.
		</p>
	</div>
</div>
